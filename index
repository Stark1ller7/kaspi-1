      letter-spacing: 1px;
    }
    header p { color: #94a3b8; font-size: 1.1rem; margin-top: 8px; }
    .slides-container {
      width: 100%;
      max-width: 850px;
      display: flex;
      flex-direction: column;
      gap: 25px;
    }
    .slide {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
      position: relative;
    }
    .slide-number {
      position: absolute;
      top: 20px;
      right: 25px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #0284c7;
      background: rgba(2, 132, 199, 0.12);
      padding: 4px 12px;
      border-radius: 20px;
      border: 1px solid rgba(2, 132, 199, 0.25);
    }
    .slide h2 {
      font-size: 1.5rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 15px;
      padding-bottom: 8px;
      border-bottom: 2px solid #0284c7;
      display: inline-block;
    }
    .slide p { color: #cbd5e1; font-size: 0.98rem; line-height: 1.6; margin-bottom: 15px; }
    .slide ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .slide ul li {
      position: relative;
      padding-left: 22px;
      color: #e2e8f0;
      font-size: 0.95rem;
      line-height: 1.5;
    }
    .slide ul li::before {
      content: "•";
      color: #0284c7;
      font-size: 1.4rem;
      position: absolute;
      left: 4px;
      top: -3px;
    }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 15px; }
    .card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      padding: 16px;
    }
    .card h3 { font-size: 1.05rem; color: #0284c7; margin-bottom: 6px; }
    .card .stat { font-size: 1.6rem; font-weight: 800; color: #f59e0b; margin-bottom: 4px; }
    .badge {
      display: inline-block;
      background: #0284c7;
      color: #ffffff;
      font-weight: 700;
      font-size: 0.75rem;
      padding: 3px 10px;
      border-radius: 4px;
      margin-bottom: 12px;
      text-transform: uppercase;
    }
    pre {
      background: #050c1a;
      border: 1px solid rgba(2, 132, 199, 0.3);
      padding: 15px;
      border-radius: 8px;
      overflow-x: auto;
      font-family: monospace;
